{
  "name": "song-api",
  "version": "1.0.0",
  "description": "Minimal REST API for serving songs to mobile clients",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/data', 'dist/data', { recursive: true })\"",
    "start": "node dist/index.js"
  },
  "keywords": [
    "express",
    "typescript",
    "songs",
    "api",
    "mobile"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
